{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Create Debug Build Directory",
      "type": "shell",
      "command": "mkdir",
      "args": [
        "-p",
        "${workspaceFolder}/build/Debug"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build OpenGL",
      "type": "shell",
      "command": "clang++",
      "args": [
        "-std=c++17",
        "-Wall",
        "${workspaceFolder}/*.cpp",
        "-framework", "OpenGL",
        "-framework", "GLUT",
        "-o", "${workspaceFolder}/build/Debug/outDebug"
      ],
      "dependsOn": "Create Debug Build Directory",
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
